# Copy to .env and fill in. See PRD.md §13 for where these come from.

# Public — safe to ship in the browser bundle.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SITE_URL=https://roambengal.com

# Server-side mirrors of the above, read via process.env during SSR.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# SECRET. Bypasses RLS — used only by submitInquiry. Supply at runtime (-e), never
# as a Docker build arg: build args are baked into the image.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Playwright end-to-end tests (npm run test:e2e). An existing admin account —
# accounts are provisioned by hand, the suite does not create one.
PLAYWRIGHT_TEST_EMAIL=admin@example.com
PLAYWRIGHT_TEST_PASSWORD=change-me
PLAYWRIGHT_BASE_URL=http://localhost:3000
